# Copy this file to /etc/agent-bot.env on the VM (chmod 600, owned by the service user)
# and fill in real values. Never commit a filled-in copy of this file.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Comma-separated Telegram numeric user IDs allowed to talk to the bot.
# Get your own ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=111111111

# --- GitHub ---
# Fine-grained Personal Access Token, scoped to only the repos below.
# Create at: GitHub -> Settings -> Developer settings -> Fine-grained tokens
# Permissions needed: Contents (Read/write), Issues (Read/write), Pull requests (Read/write)
# Set an expiration date and put a reminder to rotate it before it lapses.
GITHUB_TOKEN=github_pat_ExampleToken
GITHUB_ORG=your-org-name
# Comma-separated repo names (not full URLs) under GITHUB_ORG the agent may touch.
AGENT_REPOS=backend,frontend

# --- Claude Code ---
# From `claude setup-token` run on your laptop (see README step 5).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-ExampleToken
AGENT_MAX_TURNS=40
AGENT_JOB_TIMEOUT_SECONDS=1800

# --- Paths ---
AGENT_WORKDIR=/srv/agent/repos
